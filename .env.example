# ─────────────────────────────────────────────────────────────
#  Sophia Auréa — Website · variables de entorno
#  Copiar a .env.local para desarrollo. En produccion se cargan
#  en Vercel → Settings → Environment Variables.
#  Los nombres coinciden con los que ya usa el catalogo en
#  produccion, para reutilizar el mismo .env sin renombrar nada.
# ─────────────────────────────────────────────────────────────

# --- Microsoft Graph (Azure AD) ------------------------------
# App con permisos de APLICACION: Files.Read.All (+ Sites.Read.All
# solo si algun dia se leen bibliotecas de SharePoint).
# Requiere consentimiento de administrador.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- OneDrive: donde viven el Excel y las fotos --------------
ONEDRIVE_USER_EMAIL=hola@sophiaaurea.co

# Archivo de Excel del catalogo (solo el nombre)
EXCEL_FILE_NAME=TablaProductos_Sophia_Aurea.xlsx
# Carpeta del Excel dentro del OneDrive. Vacio = raiz.
# Ej: SOI/02-Operacion
EXCEL_CARPETA=

# Nombre de la TABLA dentro del Excel (Diseno de tabla → Nombre de tabla).
# OJO: no es el nombre del archivo.
CATALOGO_TABLA=TablaProductos

# La columna ruta_foto del Excel guarda una RUTA COMPLETA relativa a la
# carpeta de trabajo de la marca, p. ej.
#   /01-Marca/fotografia/Fotografia productos julio 29 - 1 pdn/Pieza.jpg
# FOTOS_BASE es la carpeta que antecede a esa ruta en el OneDrive.
FOTOS_BASE=SOI

# Respaldo: carpetas donde buscar por NOMBRE de archivo si la ruta completa
# no resuelve. Admite varias separadas por coma.
PHOTOS_FOLDER=/SOI/01-Marca/fotografia/Fotografia productos julio 29 - 1 pdn,/SOI/01-Marca/fotografia/Fotografías productos agosto 5 - 2 pan/fotografias peso web

# --- Revalidacion bajo demanda -------------------------------
# Secreto propio. Se usa en POST /api/revalidar?secreto=...
REVALIDAR_SECRETO=cambia-esto-por-algo-largo-y-aleatorio

# --- Canal de venta ------------------------------------------
# Numero en formato internacional sin + ni espacios. Ej: 573001234567
NEXT_PUBLIC_WHATSAPP=
# whatsapp | wompi | mercadopago   (hoy: whatsapp)
NEXT_PUBLIC_CANAL_VENTA=whatsapp
# Mostrar precios. El negocio decidio mostrarlos como filtro de contacto.
NEXT_PUBLIC_MOSTRAR_PRECIOS=true

# --- Catalogo en produccion ----------------------------------
# Si el catalogo vive en OTRO proyecto de Vercel, poner aqui su URL para
# que este sitio reenvie /catalogo hacia alla sin tocarlo.
CATALOGO_EXTERNO_URL=https://catalogo.sophiaaurea.co

# --- Analitica y dominio -------------------------------------
NEXT_PUBLIC_GA_ID=G-4PEDMYDDRS
NEXT_PUBLIC_SITIO_URL=https://sophiaaurea.co

# --- Pasarela de pagos (aun no activa, ver src/lib/comercio.ts) ---
# WOMPI_LLAVE_PUBLICA=
# WOMPI_LLAVE_PRIVADA=
# WOMPI_SECRETO_EVENTOS=
